{
  "$comment": [
    "Hand-maintained overlay for Scripts/provider-catalog-gen.mjs.",
    "Upstream manifests (extensions/*/openclaw.plugin.json) own model rows, env vars, auth methods, discovery, aliases,",
    "suppressions, contracts and model-id normalization. This file only supplies what upstream keeps in TypeScript",
    "(display names, default auth mode, TS-defined catalogs such as minimax/openrouter/synthetic) and the SDK-local entries.",
    "`textProviders` order is the order of OpenClawReferenceProviderCatalog.entries."
  ],
  "textProviders": [
    {
      "id": "openai",
      "displayName": "OpenAI",
      "auth": "api-key",
      "defaultModel": "gpt-6-astra"
