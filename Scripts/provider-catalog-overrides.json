      "id": "openai-compatible",
      "displayName": "OpenAI Compatible",
      "sdkLocal": true,
      "auth": "api-key",
      "envVars": [
        "OPENAI_API_KEY"
      ],
      "authMethods": [
        "api-key"
      ],
      "discovery": "static",
      "catalogFrom": {
        "provider": "openai",
        "models": [
          "gpt-5.4-mini"
        ]
      },
      "catalogPatch": {
        "api": "openai-completions",
        "dropModelFields": [
          "thinkingLevelMap",
          "compat",
          "mediaInput",
          "contextTokens"
        ]
      },
      "capabilities": [
        "embedding"
      ],
      "$comment": "SDK-local OpenAI-compatible endpoint; upstream core also registers an openai-compatible embedding provider."
