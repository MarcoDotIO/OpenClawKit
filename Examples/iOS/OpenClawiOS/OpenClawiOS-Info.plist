<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES). Xcode has no
	INFOPLIST_KEY_* build settings for these keys, so they live here. BGTaskScheduler only
	accepts identifiers listed below; OpenClawBackgroundTasks.submit(_:) returns the
	scheduler's notPermitted error otherwise.
	-->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>io.marcodotio.OpenClawiOS.refresh</string>
		<string>io.marcodotio.OpenClawiOS.processing</string>
		<string>io.marcodotio.OpenClawiOS.continued-processing.*</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
</dict>
</plist>
